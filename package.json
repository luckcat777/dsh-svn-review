{
  "name": "dsh-svn-review",
  "version": "0.2.1",
  "displayName": "DSH SVN Review",
  "description": "SVN change-set scoping plus language and version detection for DeepSeek Harness code review: reads .svn/wc.db directly (no svn.exe), pins down the project language and version, and hands over the matching review rules so findings are judged by that language instead of generic ones.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "svn",
    "subversion",
    "code-review",
    "diff",
    "working-copy",
    "tortoisesvn",
    "java",
    "kotlin",
    "rust",
    "golang",
    "python",
    "csharp",
    "cpp",
    "typescript",
    "harmonyos",
    "arkts"
  ],
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test",
    "sync:rules": "node tools/sync-rules.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "rules",
    "!rules/local.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.5.0 || >=23.4.0",
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckcat777/dsh-svn-review.git"
  },
  "homepage": "https://github.com/luckcat777/dsh-svn-review#readme",
  "bugs": {
    "url": "https://github.com/luckcat777/dsh-svn-review/issues"
  }
}
